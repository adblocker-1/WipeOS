+/* ShredOS GUI: write the state of every selected drive to a small key=value file.
+ * The file is written to <path>.tmp and renamed, so readers never see partial data. */
+static void nwipe_write_status_file( nwipe_context_t** c, int count, int final )
+{
+    char tmp[PATHNAME_MAX + 8];
+    FILE* fp;
+    int i;
+    time_t now = time( NULL );
+
+    if( nwipe_options.status_file[0] == '\0' )
+        return;
+
+    snprintf( tmp, sizeof( tmp ), "%s.tmp", nwipe_options.status_file );
+    fp = fopen( tmp, "w" );
+    if( fp == NULL )
+        return;
+
+    fprintf( fp, "version=%s\n", version_string );
+    fprintf( fp, "time=%lld\n", (long long) now );
+    fprintf( fp, "final=%d\n", final );
+    fprintf( fp, "count=%d\n", count );
+    fprintf( fp, "method=%s\n", nwipe_method_label( nwipe_options.method ) );
+    fprintf( fp, "prng=%s\n", nwipe_options.prng ? nwipe_options.prng->label : "" );
+    fprintf( fp, "verify=%d\n", (int) nwipe_options.verify );
+    fprintf( fp, "noblank=%d\n", nwipe_options.noblank );
+
+    for( i = 0; i < count; i++ )
+    {
+        nwipe_context_t* d = c[i];
+        double percent = 0.0;
+        double elapsed = 0.0;
+        unsigned long long tput = 0;
+        long long eta = -1;
+
+        if( d->round_size > 0 )
+            percent = (double) d->round_done / (double) d->round_size * 100.0;
+        if( d->wipe_status == 0 && d->result == 0 )
+            percent = 100.0;
+        if( d->start_time > 0 )
+            elapsed = difftime( d->wipe_status == 0 && d->end_time > 0 ? d->end_time : now, d->start_time );
+        if( elapsed > 0 )
+            tput = (unsigned long long) ( (double) d->round_done / elapsed );
+        if( tput > 0 && d->round_size > d->round_done && d->wipe_status == 1 )
+            eta = (long long) ( ( d->round_size - d->round_done ) / tput );
+
+        fprintf( fp, "d%d.device=%s\n", i, d->device_name ? d->device_name : "" );
+        fprintf( fp, "d%d.model=%s\n", i, d->device_model ? d->device_model : "" );
+        fprintf( fp, "d%d.serial=%s\n", i, d->device_serial_no );
+        fprintf( fp, "d%d.bus=%s\n", i, d->device_type_str );
+        fprintf( fp, "d%d.size=%llu\n", i, (unsigned long long) d->device_size );
+        fprintf( fp, "d%d.status=%d\n", i, d->wipe_status );
+        fprintf( fp, "d%d.result=%d\n", i, d->result );
+        fprintf( fp, "d%d.percent=%.2f\n", i, percent );
+        fprintf( fp, "d%d.pass=%d\n", i, d->pass_working );
+        fprintf( fp, "d%d.passes=%d\n", i, d->pass_count );
+        fprintf( fp, "d%d.passtype=%d\n", i, (int) d->pass_type );
+        fprintf( fp, "d%d.round=%d\n", i, d->round_working );
+        fprintf( fp, "d%d.rounds=%d\n", i, d->round_count );
+        fprintf( fp, "d%d.throughput=%llu\n", i, tput );
+        fprintf( fp, "d%d.eta=%lld\n", i, eta );
+        fprintf( fp, "d%d.start=%lld\n", i, (long long) d->start_time );
+        fprintf( fp, "d%d.end=%lld\n", i, (long long) d->end_time );
+        fprintf( fp, "d%d.bytes_erased=%llu\n", i, (unsigned long long) d->bytes_erased );
+        fprintf( fp, "d%d.pass_errors=%llu\n", i, (unsigned long long) d->pass_errors );
+        fprintf( fp, "d%d.verify_errors=%llu\n", i, (unsigned long long) d->verify_errors );
+        fprintf( fp, "d%d.fsync_errors=%llu\n", i, (unsigned long long) d->fsyncdata_errors );
+        fprintf( fp, "d%d.hpa_status=%d\n", i, d->HPA_status );
+    }
+
+    fflush( fp );
+    fsync( fileno( fp ) );
+    fclose( fp );
+    rename( tmp, nwipe_options.status_file );
+}
