#!/bin/bash
#
# Starts the graphical WipeOS user interface on tty1.
# Falls back to the classic nwipe interface if there is no framebuffer
# or if the boot parameter wipeos_gui=0 is set.
#
cd /

if grep -qw "wipeos_gui=0" /proc/cmdline; then
	exec /usr/bin/nwipe_launcher
fi

# wait briefly until USB devices (stick, keyboard, mouse) are detected
printf "\n  Starting WipeOS ...\n"
prev=""
for i in $(seq 1 15); do
	cur=$(dmesg | grep -ci usb)
	[ "$cur" = "$prev" ] && [ $i -gt 3 ] && break
	prev=$cur
	sleep 1
done

# find the WipeOS stick and mount it read-write (customers, reports)
mkdir -p /mnt/shredos
part=$(/usr/bin/find_shredos_boot_disc.sh 2>/dev/null)
if [ -n "$part" ] && mount -o rw "$part" /mnt/shredos 2>/dev/null; then
	export SHREDOS_DATA=/mnt/shredos
	mkdir -p /mnt/shredos/reports /mnt/shredos/wipeos
fi

# keyboard layout: boot parameter wipeos_kbd=de, default us
kbd=$(sed -n 's/.*wipeos_kbd=\([a-z]*\).*/\1/p' /proc/cmdline)
export SHREDOS_KBD=${kbd:-us}

echo 0 > /sys/class/graphics/fbcon/cursor_blink 2>/dev/null
setterm --cursor off 2>/dev/null
clear

while true; do
	/usr/bin/shredos-gui
	rc=$?
	case $rc in
		10)
			clear
			sync; umount /mnt/shredos 2>/dev/null
			exec /usr/bin/nwipe_launcher
			;;
		20)
			clear; echo "Shutting down ..."
			sync; umount /mnt/shredos 2>/dev/null
			poweroff
			sleep 30
			;;
		21)
			clear; echo "Restarting ..."
			sync; umount /mnt/shredos 2>/dev/null
			reboot
			sleep 30
			;;
		2)
			# no framebuffer: classic interface
			sync; umount /mnt/shredos 2>/dev/null
			exec /usr/bin/nwipe_launcher
			;;
		*)
			sleep 1
			;;
	esac
done
